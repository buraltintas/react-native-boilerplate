{
  "name": "react-native-boilerplate",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules && rm -rf ios && rm -rf android && npm install"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-asset": "~11.0.0",
    "expo-font": "~13.0.0",
    "expo-file-system": "~18.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-constants": "~17.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-camera": "~16.0.0",
    "expo-barcode-scanner": "~14.0.0",
    "expo-localization": "~16.0.0",
    "react-native-google-mobile-ads": "^14.3.2",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "@react-navigation/native": "^7.0.7",
    "@react-navigation/native-stack": "^7.2.1",
    "@react-navigation/bottom-tabs": "^7.2.1",
    "@tanstack/react-query": "^5.64.2",
    "zustand": "^5.0.2",
    "react-native-screens": "~4.4.0",
    "react-native-safe-area-context": "4.12.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "i18next": "^24.2.0",
    "react-i18next": "^15.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "react-native-device-info": "^13.0.0",
    "react-native-keychain": "^9.0.2",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "@gorhom/bottom-sheet": "^5.0.5",
    "socket.io-client": "^4.8.1",
    "expo-notifications": "~0.29.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "^18.3.18",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.6.2",
    "babel-plugin-module-resolver": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
